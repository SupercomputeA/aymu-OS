{
  "$comment": "Immersion OS design tokens — steel-vault. Documented palette mirror, kept in sync with the code (the code is canonical — this records what the UI uses, it does not drive it).",
  "name": "Immersion OS — steel vault",
  "version": "1.5.0",
  "palette": {
    "navy": "#0a1330",
    "slate": "#0d1f3d",
    "steel": "#1a2f4d",
    "brass": "#c9a33a",
    "dark-brass": "#8a6d1f",
    "cream": "#e8dcc0"
  },
  "semantic": {
    "background": "222 45% 5%",
    "foreground": "40 20% 90%",
    "card": "222 28% 9%",
    "card-foreground": "40 20% 90%",
    "popover": "222 26% 7%",
    "primary": "40 45% 52%",
    "primary-foreground": "222 45% 8%",
    "secondary": "217 18% 24%",
    "muted": "222 18% 14%",
    "muted-foreground": "40 10% 54%",
    "accent": "40 45% 52%",
    "destructive": "0 62% 50%",
    "border": "222 22% 17%",
    "input": "222 20% 13%",
    "ring": "40 45% 52%"
  },
  "accents": {
    "brass": { "hsl": "40 45% 52%", "note": "default" },
    "indigo": { "hsl": "230 85% 55%" },
    "cyan": { "hsl": "190 85% 55%" },
    "orange": { "hsl": "25 95% 55%" },
    "amber": { "hsl": "45 95% 55%" },
    "emerald": { "hsl": "150 70% 50%" },
    "pink": { "hsl": "330 80% 65%" },
    "purple": { "hsl": "280 70% 60%" }
  },
  "shader": {
    "nero": {
      "colorBack": "#0a1330",
      "colorMid": "#0d1f3d",
      "colorFront": "#c9a33a",
      "brightness": 0.05,
      "contrast": 0.2,
      "speed": 0.5
    }
  },
  "radius": {
    "base": "0.5rem",
    "note": "the single --radius value; no ad-hoc corners"
  },
  "type": {
    "hero": "24px",
    "title": "20px",
    "body": "16px",
    "secondary": "14px",
    "label": "12px",
    "note": "micro-labels never below 12px"
  },
  "spacing": {
    "base": "0.25rem",
    "note": "4px grid; no ad-hoc spacing outside the two noted exceptions (TopBar gap-[2px], TerminalApp pl-[10px])"
  },
  "elevation": {
    "glass": "0.88 alpha surface + 12px blur",
    "dock": "0.9 alpha surface",
    "note": "see --glass-* / --dock-* in index.css"
  },
  "principles": [
    "locked palette — no new hues without an RFC",
    "honest-by-construction — nothing fabricated, unset = not wired",
    "procedural identity — zero arbitrary uploads",
    "deployed ≠ minted, zero ≠ unknown"
  ]
}
